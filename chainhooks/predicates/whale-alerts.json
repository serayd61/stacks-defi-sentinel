{
  "uuid": "defi-sentinel-whale-alerts",
  "name": "DeFi Sentinel - Whale Alerts",
  "version": 1,
  "chain": "stacks",
  "networks": {
    "mainnet": {
      "if_this": {
        "scope": "stx_event",
        "actions": ["transfer"],
        "start_block": 170000
      },
      "then_that": {
        "http_post": {
          "url": "https://stacks-defi-sentinel-production.up.railway.app/webhooks/whale-alerts",
          "authorization_header": "Bearer defi-sentinel-chainhooks"
        }
      }
    }
  }
}

