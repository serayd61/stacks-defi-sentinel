{
  "version": "1",
  "name": "DeFi Sentinel - Whale Alerts",
  "chain": "stacks",
  "network": "mainnet",
  "filters": {
    "events": [
      {
        "type": "stx_transfer"
      }
    ]
  },
  "action": {
    "type": "http_post",
    "url": "https://stacks-defi-sentinel-production.up.railway.app/webhooks/whale-alerts"
  },
  "options": {
    "decode_clarity_values": true,
    "enable_on_registration": true
  }
}
